# Available environments: development, production
NODE_ENV=development

# Required for Google AI API usage
GOOGLE_API_KEY=

# Postgres connection string. This value matches the local docker-compose.yml.
DATABASE_URL=postgres://examklaar:secret@localhost:5432/examklaar

# Better Auth. The secret must be at least 32 characters: openssl rand -base64 32
# BETTER_AUTH_URL is the app's own origin, used for the links in auth emails.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Brevo HTTP API, used for the signup confirmation and password reset emails.
# BREVO_API_KEY is an API key (Brevo: SMTP & API > API keys), not an SMTP key.
# EMAIL_FROM_ADDRESS must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@examklaar.nl
EMAIL_FROM_NAME=Examklaar

# S3-compatible object storage for speaking recordings (private bucket).
# Set a 30-day expiry lifecycle rule on this bucket: the app only deletes
# recordings when an account is erased (scripts/delete-user.ts).
#
# On Cloudflare R2 the endpoint is https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# and the region is always "auto". Create an R2 API token with Object Read &
# Write scoped to the recordings bucket alone: the app never reaches exam-assets
# over the S3 API, it only builds public URLs for it.
S3_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_RECORDINGS=speaking-recordings

# Public base URL for exam assets (images, audio, video) in the exam-assets
# bucket. Substituted into exam content at read time. No trailing slash.
# On R2 this is a custom domain bound to the bucket, and the bucket root is the
# domain root, so there is no bucket name in the path: https://cdn.examklaar.nl
EXAM_ASSETS_BASE_URL=https://cdn.examklaar.nl

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
ANALYTICS_GA_MEASUREMENT_ID=

# Local-only: tunnel host (no protocol, e.g. abc123.trycloudflare.com). When set,
# next.config.ts adds it to allowedDevOrigins so the site is reachable through the
# tunnel's public URL (viewing on another device, sharing).
# Leave empty otherwise.
DEV_TUNNEL_HOST=
