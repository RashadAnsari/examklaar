# Available environments: development, production
NODE_ENV=development

# Required for Google AI API usage
GOOGLE_API_KEY=

# Supabase configuration
SUPABASE_PUBLIC_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
ANALYTICS_GA_MEASUREMENT_ID=

# Number of trusted reverse proxies in front of the app. Used to pick the real
# client IP from X-Forwarded-For for rate limiting (the right-most N values are
# written by trusted proxies; the left-most is client-supplied and spoofable).
# Set to the number of proxies you run (1 for a single nginx/Traefik). Default 1.
TRUSTED_PROXY_COUNT=1

# Current payment provider. Supported values: "paddle"
PAYMENT_PROVIDER=

# Required when PAYMENT_PROVIDER=paddle
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Monthly plan price, configured in Paddle with a 7-day trial (new customers)
PADDLE_PRICE_ID_MONTHLY=
# Same monthly plan price but without a trial (returning customers, no repeat trial)
PADDLE_PRICE_ID_MONTHLY_NO_TRIAL=
