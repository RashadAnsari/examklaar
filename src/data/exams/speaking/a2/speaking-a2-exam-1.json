      "content": "<video controls data-transcription=\"Ik koop op zaterdag altijd brood bij de bakker. Waar koopt u meestal brood? Vertel ook waarom.\" style=\"width: 100%; max-width: 560px; margin: 0.75rem 0; display: block;\"><source src=\"{{EXAM_ASSETS_BASE_URL}}/speaking/a2/exam-1/b18a4453-96df-415f-b9b0-7d025b9c899f.mp4\" type=\"video/mp4\" /></video>",
